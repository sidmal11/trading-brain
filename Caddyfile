# Automatic HTTPS for DOMAIN (set in the environment or .env).
# One origin for the dashboard and the API keeps the session cookie same-site.
{$DOMAIN} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/dashboard
        try_files {path} /index.html
        file_server
    }
}
